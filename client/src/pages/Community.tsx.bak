                      <li>Make financial learning social and fun</li>
                    </ul>
                  </div>
                  <div className="flex items-center justify-center sm:justify-end">
                    <Button 
                      className="bg-[#2C6E49] hover:bg-[#235539]"
                      onClick={() => setShowPartnerModal(true)}
                    >
                      <Users className="h-4 w-4 mr-2" />
                      Find a Challenge Partner
                    </Button>
                  </div>
                </div>
              </CardContent>
            </Card>
            
            <div className="grid grid-cols-1 md:grid-cols-2 gap-6">
              {challenges.map((challenge) => (
                <Card key={challenge.id} className="hover:shadow-md transition-shadow">
                  <CardHeader className="pb-2">
                    <CardTitle>{challenge.title}</CardTitle>
                    <CardDescription className="flex justify-between items-center">
                      <Badge className={`
                        ${challenge.difficulty === "Easy" ? "bg-secondary-100 text-secondary-700" : 
                          challenge.difficulty === "Medium" ? "bg-primary-100 text-primary-700" : 
                          "bg-accent-100 text-accent-700"}
                      `}>
                        {challenge.difficulty}
                      </Badge>
                      <span className="text-sm">Ends: {challenge.endDate}</span>
                    </CardDescription>
                  </CardHeader>
                  <CardContent>
                    <p className="text-neutral-600 mb-4">
                      {challenge.description}
                    </p>
                    
                    <div className="space-y-3">
                      <div>
                        <div className="flex justify-between text-sm mb-1">
                          <span>Completion Rate</span>
                          <span>{challenge.completionRate}%</span>
                        </div>
                        <div className="w-full bg-neutral-200 rounded-full h-2">
                          <div 
                            className="bg-primary-500 h-2 rounded-full" 
                            style={{ width: `${challenge.completionRate}%` }}
                          ></div>
                        </div>
                      </div>
                      
                      <div className="flex items-center justify-between text-sm text-neutral-600">
                        <div className="flex items-center">
                          <Users className="h-4 w-4 mr-2" />
                          {challenge.participants.toLocaleString()} participants
                        </div>
                        <div className="flex items-center">
                          <Trophy className="h-4 w-4 mr-2 text-yellow-500" />
                          Prize: {challenge.prizePool}
                        </div>
                      </div>
                    </div>
                    
                    <Tabs defaultValue="details" className="mt-4">
                      <TabsList className="grid w-full grid-cols-3 gap-1">
                        <TabsTrigger value="details" className="text-xs sm:text-sm">
                          Details
                        </TabsTrigger>
                        <TabsTrigger value="leaderboard" className="text-xs sm:text-sm">
                          <span className="hidden xs:inline">Leaderboard</span>
                          <span className="xs:hidden">Leaders</span>
                        </TabsTrigger>
                        <TabsTrigger value="comments" className="text-xs sm:text-sm">
                          <span className="hidden xs:inline">Comments</span>
                          <span className="xs:hidden">Chat</span>
                        </TabsTrigger>
                      </TabsList>
                      <TabsContent value="details" className="pt-4">
                        <div className="space-y-4">
                          <div>
                            <h4 className="font-medium text-sm mb-1">How to participate:</h4>
                            <ol className="list-decimal pl-5 text-sm">
                              <li>Join the challenge</li>
                              <li>Complete daily tasks in the SavyFunds app</li>
                              <li>Track your progress and earn points</li>
                              <li>Share your insights with the community</li>
                            </ol>
                          </div>
                          <Button 
                            className="w-full"
                            onClick={() => {
                              setSelectedChallenge(challenge.id);
                              setShowJoinModal(true);
                            }}
                          >Join Challenge</Button>
                        </div>
                      </TabsContent>
                      <TabsContent value="leaderboard" className="pt-4">
                        <div className="space-y-3">
                          <h4 className="font-medium text-sm">Top Performers</h4>
                          {challenge.leaderboard.map((entry, index) => (
                            <div key={index} className="flex items-center justify-between border-b pb-2 last:border-0">
                              <div className="flex items-center">
                                <span className={`w-5 h-5 rounded-full flex items-center justify-center mr-2 text-xs
                                  ${index === 0 ? "bg-yellow-100 text-yellow-700" : 
                                    index === 1 ? "bg-neutral-200 text-neutral-700" : 
                                    index === 2 ? "bg-amber-100 text-amber-700" : "bg-neutral-100 text-neutral-700"
                                  }`}>
                                  {entry.rank}
                                </span>
                                <span>{entry.name}</span>
                              </div>
                              <span className="font-medium">{entry.points} pts</span>
                            </div>
                          ))}
                        </div>
                      </TabsContent>
                      <TabsContent value="comments" className="pt-4">
                        <div className="space-y-3">
                          {challenge.comments.map((comment, index) => (
                            <div key={index} className="border-b pb-3 last:border-0">
                              <div className="flex justify-between items-center mb-1">
                                <span className="font-medium text-sm">{comment.author}</span>
                                <span className="text-xs text-neutral-500">{comment.time}</span>
                              </div>
                              <p className="text-sm">{comment.text}</p>
                            </div>
                          ))}
                          <div className="pt-2 flex gap-2">
                            <Input 
                              placeholder="Add your comment..." 
                              value={newComment}
                              onChange={(e) => setNewComment(e.target.value)}
                              className="text-sm"
                            />
                            <Button size="sm" onClick={() => {
                              if (newComment.trim()) {
                                toast({
                                  title: "Comment Added",
                                  description: "Your comment was posted successfully."
                                });
                                setNewComment("");
                              }
                            }}>
                              <Send className="h-4 w-4" />
                            </Button>
                          </div>
                        </div>
                      </TabsContent>
                    </Tabs>
                  </CardContent>
                </Card>
              ))}
            </div>
            
            <div className="bg-gradient-to-r from-primary-50 to-secondary-50 rounded-xl p-6">
              <div className="flex flex-col md:flex-row items-center justify-between">
                <div className="mb-4 md:mb-0">
                  <h3 className="text-lg font-semibold mb-2">Create Your Own Challenge</h3>
                  <p className="text-neutral-600 max-w-lg">
                    Have a great idea for a financial challenge? Create your own and invite the community to join!
                  </p>
                </div>
                <Button>
                  Create Challenge
                </Button>
              </div>
            </div>
          </TabsContent>
        </Tabs>
      </main>
      
      <Footer />
      <HelpButton />

      {/* Join Challenge Modal */}
      <Dialog open={showJoinModal} onOpenChange={setShowJoinModal}>
        <DialogContent className="sm:max-w-md">
          <DialogHeader>
            <DialogTitle>Join Financial Challenge</DialogTitle>
            <DialogDescription>
              {selectedChallenge && challenges.find(c => c.id === selectedChallenge)?.title}
            </DialogDescription>
          </DialogHeader>
          <div className="space-y-4 py-4">
            <p className="text-sm text-neutral-600">
              By joining this challenge, you'll be able to:
            </p>
            <ul className="list-disc pl-5 space-y-1 text-sm">
              <li>Track your progress toward the challenge goal</li>
              <li>Earn points and climb the leaderboard</li>
              <li>Share insights with other participants</li>
              <li>Qualify for the prize pool of {selectedChallenge && challenges.find(c => c.id === selectedChallenge)?.prizePool}</li>
            </ul>
            <div className="space-y-2">
              <Label htmlFor="notifications" className="text-sm font-medium">Notifications</Label>
              <div className="flex items-center space-x-2">
                <input type="checkbox" id="notifications" defaultChecked />
                <Label htmlFor="notifications" className="text-sm">Enable reminder notifications for this challenge</Label>
              </div>
            </div>
          </div>
          <DialogFooter className="flex justify-between sm:justify-between">
            <DialogClose asChild>
              <Button type="button" variant="outline">
                Cancel
              </Button>
            </DialogClose>
            <Button type="button" onClick={() => {
              toast({
                title: "Challenge Joined!",
                description: "You've successfully joined the challenge. Good luck!",
              });
              setShowJoinModal(false);
            }}>
              Join Challenge
            </Button>
          </DialogFooter>
        </DialogContent>
      </Dialog>

      {/* Find Partner Modal */}
      <Dialog open={showPartnerModal} onOpenChange={setShowPartnerModal}>
        <DialogContent className="sm:max-w-md">
          <DialogHeader>
            <DialogTitle>Find a Challenge Partner</DialogTitle>
            <DialogDescription>
              Partner up with a friend to achieve your financial goals together.
            </DialogDescription>
          </DialogHeader>
          <div className="space-y-4 py-4">
            <div className="space-y-2">
              <Label htmlFor="partner-email">Invite by Email</Label>
              <Input id="partner-email" placeholder="friend@example.com" />
            </div>
            <div className="space-y-2">
              <Label htmlFor="message">Personal Message (Optional)</Label>
              <Textarea id="message" placeholder="Hey! Want to team up for a financial challenge?" className="min-h-20" />
            </div>
            <div className="bg-primary-50 rounded-md p-3">
              <h4 className="font-medium text-sm mb-1">Or find a partner in the community</h4>
              <p className="text-sm text-neutral-600">Connect with other SavyFunds users looking for challenge partners.</p>
              <Button variant="link" className="px-0 text-[#2C6E49] font-medium">
                Browse Community Partners
              </Button>
            </div>
          </div>
          <DialogFooter className="flex justify-between sm:justify-between">
            <DialogClose asChild>
              <Button type="button" variant="outline">
                Cancel
              </Button>
            </DialogClose>
            <Button type="button" onClick={() => {
              toast({
                title: "Invitation Sent!",
                description: "We'll notify you when your friend accepts the invitation.",
              });
              setShowPartnerModal(false);
            }}>
              Send Invitation
            </Button>
          </DialogFooter>
        </DialogContent>
      </Dialog>

      {/* Start Discussion Modal */}
      <Dialog open={showDiscussionModal} onOpenChange={setShowDiscussionModal}>
        <DialogContent className="sm:max-w-md">
          <DialogHeader>
            <DialogTitle>Start a New Discussion</DialogTitle>
            <DialogDescription>
              Share your questions, insights, or experiences with the community.
            </DialogDescription>
          </DialogHeader>
          <div className="space-y-4 py-4">
            <div className="space-y-2">
              <Label htmlFor="discussion-title">Title</Label>
              <Input 
                id="discussion-title" 
                placeholder="What's your discussion about?"
                value={newDiscussion.title}
                onChange={(e) => setNewDiscussion({
                  ...newDiscussion,
                  title: e.target.value
                })}
              />
            </div>
            <div className="space-y-2">
              <Label htmlFor="discussion-content">Content</Label>
              <Textarea 
                id="discussion-content" 
                placeholder="Describe your topic in detail..." 
                className="min-h-32"
                value={newDiscussion.content}
                onChange={(e) => setNewDiscussion({
                  ...newDiscussion,
                  content: e.target.value
                })}
              />
            </div>
            <div className="space-y-2">
              <Label htmlFor="discussion-tags">Tags</Label>
              <Input 
                id="discussion-tags" 
                placeholder="Saving, Investing, Debt, etc. (separated by commas)"
                onChange={(e) => setNewDiscussion({
                  ...newDiscussion,
                  tags: e.target.value.split(',').map(tag => tag.trim()).filter(tag => tag)
                })}
              />
            </div>
            {loadingCategories ? (
              <div className="mt-2">Loading categories...</div>
            ) : categoriesData && categoriesData.length > 0 ? (
              <div className="space-y-2">
                <Label htmlFor="discussion-category">Category</Label>
                <select
                  id="discussion-category"
                  className="w-full p-2 border rounded-md"
                  value={newDiscussion.categoryId}
                  onChange={(e) => setNewDiscussion({
                    ...newDiscussion,
                    categoryId: parseInt(e.target.value)
                  })}
                >
                  {categoriesData.map((category: any) => (
                    <option key={category.id} value={category.id}>
                      {category.name}
                    </option>
                  ))}
                </select>
              </div>
            ) : null}
          </div>
          <DialogFooter className="flex justify-between sm:justify-between">
            <DialogClose asChild>
              <Button type="button" variant="outline">
                Cancel
              </Button>
            </DialogClose>
            <Button 
              type="button" 
              onClick={handleSubmitDiscussion}
              disabled={createPostMutation.isPending || !newDiscussion.title || !newDiscussion.content}
            >
              {createPostMutation.isPending ? 'Posting...' : 'Post Discussion'}
            </Button>
          </DialogFooter>
        </DialogContent>
      </Dialog>
    </>
  );
};

export default Community;
