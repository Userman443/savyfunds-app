  });
  
  // Format posts data for display
  const discussions = React.useMemo(() => {
    if (!postsData) return [];
    
    return postsData.map((post: any) => {
      // Format relative time (simple implementation)
      const getRelativeTime = (date: string) => {
        const now = new Date();
        const postDate = new Date(date);
        const diffTime = Math.abs(now.getTime() - postDate.getTime());
        const diffDays = Math.floor(diffTime / (1000 * 60 * 60 * 24));
        
        if (diffDays === 0) return "today";
        if (diffDays === 1) return "yesterday";
        if (diffDays < 7) return `${diffDays} days ago`;
        if (diffDays < 30) return `${Math.floor(diffDays / 7)} weeks ago`;
        return `${Math.floor(diffDays / 30)} months ago`;
      };
      
      return {
        id: post.id,
        title: post.title,
        author: post.displayName || "Anonymous User", // Will be replaced with actual user data
        authorLevel: post.level || 1,
        authorAvatar: null,
        date: getRelativeTime(post.createdAt),
        content: post.content,
        likes: post.likeCount || 0,
        replies: post.commentCount || 0,
        tags: post.tags || []
      };
    });
  }, [postsData]);
  
